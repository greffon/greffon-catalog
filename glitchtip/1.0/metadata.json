{
  "name": "GlitchTip",
  "logo": "https://gitlab.com/uploads/-/system/group/avatar/6475477/glitchtip_g.png",
  "description": "Open-source error tracking compatible with Sentry SDKs",
  "categories": [],
  "images": [],
  "configurations": [
    {
      "title": "SECRET_KEY",
      "schema": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "string",
            "title": "Django secret key (32+ chars)",
            "description": "Django secret key. Generated by the platform at instance creation.",
            "writeOnly": true,
            "minLength": 32,
            "format": "greffon-secret"
          }
        },
        "x-greffon-visibility": "advanced"
      },
      "default_value": {
        "value": ""
      },
      "destinations": [
        {
          "type": "env",
          "container": "glitchtip",
          "key": "SECRET_KEY"
        }
      ]
    },
    {
      "title": "GLITCHTIP_DOMAIN",
      "schema": {
        "properties": {
          "value": {
            "type": "string",
            "title": "GlitchTip domain URL"
          }
        },
        "x-greffon-visibility": "advanced"
      },
      "default_value": {
        "value": "{{ instance_url }}"
      },
      "destinations": [
        {
          "type": "env",
          "container": "glitchtip",
          "key": "GLITCHTIP_DOMAIN"
        },
        {
          "type": "env",
          "container": "glitchtip",
          "key": "GLITCHTIP_URL"
        },
        {
          "type": "env",
          "container": "glitchtip",
          "key": "CSRF_TRUSTED_ORIGINS"
        }
      ]
    },
    {
      "title": "DEFAULT_FROM_EMAIL",
      "schema": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Default sender email"
          }
        },
        "x-greffon-visibility": "advanced"
      },
      "default_value": {
        "value": ""
      },
      "destinations": [
        {
          "type": "env",
          "container": "glitchtip",
          "key": "DEFAULT_FROM_EMAIL"
        }
      ]
    },
    {
      "title": "GLITCHTIP_RETENTION_DAYS",
      "schema": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Data retention (days)",
            "description": "How long GlitchTip keeps ingested data before its cleanup job deletes it. This is the master default: events, transactions, logs, uptime checks and uploaded files all follow it unless pinned separately."
          }
        },
        "x-greffon-visibility": "advanced"
      },
      "default_value": {
        "value": "90"
      },
      "destinations": [
        {
          "type": "env",
          "container": "glitchtip",
          "key": "GLITCHTIP_RETENTION_DAYS"
        },
        {
          "type": "env",
          "container": "glitchtip_worker",
          "key": "GLITCHTIP_RETENTION_DAYS"
        }
      ]
    },
    {
      "title": "GLITCHTIP_EVENT_HOT_DAYS",
      "schema": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Days events stay in PostgreSQL (hot)",
            "description": "How long an error event stays in the database before it is archived out. This is the main driver of disk use on the instance, so lower it first if the greffon is growing. Keep it at or below the retention window above."
          }
        },
        "x-greffon-visibility": "advanced"
      },
      "default_value": {
        "value": "30"
      },
      "destinations": [
        {
          "type": "env",
          "container": "glitchtip",
          "key": "GLITCHTIP_EVENT_HOT_DAYS"
        },
        {
          "type": "env",
          "container": "glitchtip_worker",
          "key": "GLITCHTIP_EVENT_HOT_DAYS"
        }
      ]
    },
    {
      "title": "GLITCHTIP_FILE_RETENTION_DAYS",
      "schema": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Uploaded file retention (days)",
            "description": "How long uploaded release files (JS source maps, debug symbols) are kept. Upstream lets this follow the master retention, but declaring it here pins it: if you lower the retention above, lower this too, or old stack traces stay unminifiable for longer than you expect."
          }
        },
        "x-greffon-visibility": "advanced"
      },
      "default_value": {
        "value": "90"
      },
      "destinations": [
        {
          "type": "env",
          "container": "glitchtip",
          "key": "GLITCHTIP_FILE_RETENTION_DAYS"
        },
        {
          "type": "env",
          "container": "glitchtip_worker",
          "key": "GLITCHTIP_FILE_RETENTION_DAYS"
        }
      ]
    },
    {
      "title": "DJANGO_SUPERUSER_EMAIL",
      "schema": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Admin email",
            "format": "email"
          }
        }
      },
      "default_value": {
        "value": "admin@greffon.io"
      },
      "destinations": [
        {
          "type": "env",
          "container": "glitchtip_seed",
          "key": "DJANGO_SUPERUSER_EMAIL"
        }
      ]
    },
    {
      "title": "DJANGO_SUPERUSER_PASSWORD",
      "schema": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "string",
            "title": "Admin password",
            "writeOnly": true,
            "minLength": 8
          }
        }
      },
      "default_value": {
        "value": ""
      },
      "destinations": [
        {
          "type": "env",
          "container": "glitchtip_seed",
          "key": "DJANGO_SUPERUSER_PASSWORD"
        }
      ]
    },
    {
      "title": "SMTP",
      "schema": {
        "properties": {}
      },
      "default_value": {},
      "destinations": [
        { "type": "smtp", "container": "glitchtip",        "key": "EMAIL_URL" },
        { "type": "smtp", "container": "glitchtip_worker", "key": "EMAIL_URL" }
      ]
    }
  ]
}